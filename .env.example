# SmartLists - Variables de entorno
# Copiar este archivo como .env y completar los valores del equipo.
# El .env NO se commitea (esta en .gitignore).

JWT_SECRET_KEY=CAMBIAR_por_el_secret_del_equipo
KEYSTORE_PASS=CAMBIAR
KEYSTORE_ALIAS=systech
TRUSTSTORE_PASS=CAMBIAR
SYSTECH_API_KEY=dev-api-key-smartlists

